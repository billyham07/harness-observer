# Local data / build output
*.duckdb
*.duckdb.wal
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/bin/
/dist/

# DuckDB client library, fetched by scripts/fetch-duckdb.*. Never committed:
# it is ~36 MB of prebuilt binary that every checkout can download itself.
/third_party/

# Frontend. Node and npm are build-time only: node_modules is a dependency
# cache and dist is generated by scripts/build-web.* and embedded by Go, so
# neither belongs in history.
/webui/node_modules/
/internal/web/assets/dist/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
